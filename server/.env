# ── Variables de entorno del sistema ──────────────────
PORT=4000
NODE_ENV=development

# ── Cookies (firmado criptográfico) ────────────────────
COOKIE_SECRET=ReservaRest_Cookie_Secret_SENA_2026_CambiarEnProd

# ── Factus API (reemplaza con tus credenciales reales) ──
FACTUS_CLIENT_ID=TU_CLIENT_ID_AQUI
FACTUS_CLIENT_SECRET=TU_CLIENT_SECRET_AQUI
FACTUS_USERNAME=TU_EMAIL@restaurante.com
FACTUS_PASSWORD=TU_PASSWORD_AQUI
